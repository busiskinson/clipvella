# ClipForge AI — optional backend integrations for the Video Downloader.
# Copy to .env.local and fill in. Never commit real values.

# Facebook Reels titles/thumbnails via Meta's oEmbed Read feature (app access token "APP_ID|CLIENT_TOKEN").
# Without it, Facebook links are validated and can be imported, but show no details.
META_OEMBED_ACCESS_TOKEN=

# Authorized media service used by POST /api/media/download.
# It must only serve content the user owns or is licensed to use, honour platform terms,
# and never bypass private videos or DRM. Expected contract:
#   POST {MEDIA_SERVICE_URL}/downloads  { url, platform, format: "mp4"|"mp3", quality }
#   -> { ok: true, downloadUrl, fileName } | { ok: false, code, message }
MEDIA_SERVICE_URL=
MEDIA_SERVICE_TOKEN=
