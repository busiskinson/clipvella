# Clipvella — copy to .env.local. Never commit real values.

# Supabase (public by design; RLS protects data). Project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must match the storage bucket file_size_limit (50 on the Supabase free plan).
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Edge Function secrets (Supabase dashboard → Edge Functions → Secrets), NOT this file:
#   META_OEMBED_ACCESS_TOKEN   optional, Facebook Reels titles/thumbnails ("APP_ID|CLIENT_TOKEN")
#   STORAGE_LIMIT_BYTES        optional, default 1073741824 (1 GiB free plan)
# Worker secrets live in worker/.env — see worker/.env.example.
