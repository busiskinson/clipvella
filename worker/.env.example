# Clipvella worker — copy to worker/.env (gitignored). NEVER commit real values.
# Supabase → Project Settings → API → "service_role" / secret key. Server-side only.
SUPABASE_URL=https://wtobecjnjmhovvpwdcic.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Free keys: https://console.groq.com/keys  and  https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-flash-latest
# tried in order when the main model is busy (free tier often is)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
WORKER_ID=this-pc

# Link import (yt-dlp): public videos only, after the user confirms they own it or have permission
WORKER_MAX_IMPORT_MINUTES=10
